# ==============================================================================
# SI-WARGA RT: Konfigurasi Environment Variables
# ==============================================================================

# 1. Database URL
# Lokal (SQLite):
DATABASE_URL="file:./dev.db"

# Untuk Cloud / PostgreSQL (Supabase / Neon):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Keamanan & Autentikasi Pengurus RT
JWT_SECRET="ganti_dengan_random_secret_string_32_karakter"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password_admin_rahasia"

# 3. Google Gemini API Key untuk AI OCR Scanner
# Dapatkan gratis di https://aistudio.google.com/app/apikey
# Bisa multi-key dipisah koma untuk rotasi otomatis jika mencapai limit kuota
GEMINI_API_KEY="masukkan_api_key_gemini_anda_di_sini"

# 4. Mode Web Publik (opsional untuk deployment cloud publik)
# NEXT_PUBLIC_IS_PUBLIC_WEB="false"
